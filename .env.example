# ── Binance Demo ──────────────────────────────────────────────
BINANCE_DEMO_URL=https://demo-api.binance.com
BINANCE_DEMO_API_KEY=your_demo_api_key_here
BINANCE_DEMO_API_SECRET=your_demo_api_secret_here

# ── DeepSeek ──────────────────────────────────────────────────
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com
# Thinking mode gives a more reasoned, planned decision; fine at hourly cadence.
DEEPSEEK_THINKING=true
DEEPSEEK_MAX_TOKENS=10000
DEEPSEEK_REASONING_EFFORT=high

# ── Telegram control (optional but recommended) ──────────────
# Create a bot via @BotFather → paste the token. Message the bot /start once;
# your chat id is captured automatically (or set TELEGRAM_CHAT_ID to lock it).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Default strategy on first start: swing (current 1h setup) | scalping (3m)
DEFAULT_STRATEGY=swing
# Spot venue is long-only. Leave false to reject SELL (short) entries; set true
# only when running on a futures venue that supports shorts.
# ALLOW_SHORT=false
#
# LLM position manager: when a position is open, DeepSeek analyzes it every cycle
# and may HOLD, TRAIL the stop-loss (lock profit / breakeven), or EXIT. On by
# default for ALL strategies (swing, scalping, mt5). Set false to disable.
# POSITION_MANAGER=true

# ── Trading ───────────────────────────────────────────────────
SYMBOL=BTCUSDT
INTERVAL=1h
CANDLES=20
# Extra history fetched for quant indicator computation (SMA25/MACD26/BB20
# need >= 26 bars). Only the last CANDLES are shown to the model as raw candles.
FETCH_LIMIT=120

# ── Per-strategy overrides (optional) ─────────────────────────
# SWING_INTERVAL=1h             # SWING_CANDLES=20
# SWING_FETCH_LIMIT=120         # SWING_RUN_EVERY_MINUTES=60
# SCALP_INTERVAL=3m             # SCALP_CANDLES=60
# SCALP_FETCH_LIMIT=300         # SCALP_RUN_EVERY_MINUTES=5
# SCALP_VOLUME_MIN=1.0          # min volume ratio for scalping entry (1.2 = stricter, 0.9 = looser)
# SCALP_REGIME_SEP_PCT=0.02     # min EMA9/21 separation (% of price) to call a directional regime; below this = flat

# ── Risk guardrails (defaults for ~$100) ─────────────────────
TARGET_CAPITAL_USD=100
MAX_RISK_PCT=0.02
MAX_POSITION_USD=50
MIN_NOTIONAL_USD=10
CONFIDENCE_THRESHOLD=0.55

# ── Schedule ──────────────────────────────────────────────────
RUN_EVERY_HOURS=1

# ── MetaTrader 5 (MT5) setup — third strategy ─────────────────
# Switch with /strategy mt5. Requires the Wine+MT5 runtime:
#   docker compose -f docker-compose.mt5.yml up -d --build
# DEMO ONLY — never point MT5_PASSWORD at a live account.
# Your MT5 DEMO account credentials (login, password, broker server name).
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=
# Symbols traded by the MT5 setup (exact names as in the MT5 Market Watch).
MT5_SYMBOLS=XAUUSD,EURUSD
# MT5_TREND_INTERVAL=m15     # higher-timeframe trend filter
# MT5_ENTRY_INTERVAL=m5      # lower-timeframe entry
# MT5_CANDLES=40             # candles shown to the model
# MT5_FETCH_LIMIT=300        # history fetched for indicator math
# MT5_RUN_EVERY_MINUTES=5    # cycle cadence
# MT5_VOLUME_MIN=1.0         # hard min volume ratio for an entry (enforced in code)
# MT5_REGIME_SEP_PCT=0.02    # min EMA9/21 separation (%) to call a directional regime
# MT5_RSI_MIN=25             # hard no-chase band: reject entries outside [25, 75]
# MT5_RSI_MAX=75
# MT5_TRAIL_MIN_ATR=0.5      # min trailing-stop distance = this x ATR(entry)
# MT5_MIN_STOP_ATR=0.5       # min entry stop distance = this x ATR(entry)
# MT5_FORCE_EXIT_FLIP=true   # safety-exit when the M15 trend flips against the position
# MT5_FORCE_EXIT_LOSS_SL_MULT=0.5  # safety-exit when loss >= this x SL distance
# MT5_MIN_LOT=0.01           # minimum lot size
# MT5_MAX_LOT=1.0            # maximum lot size
# MT5_RISK_PCT=0.02          # max loss per trade as % of MT5 balance
# MT5_FAST_LLM=true          # use fast (no-thinking) DeepSeek mode
# MT5_MAGIC=424242           # order magic number
# MT5 HTTP bridge (Linux): the in-container Wine-Python bridge (mt5_bridge.py)
# listens on this URL. Layout B keeps it localhost:18080.
# MT5_BRIDGE_URL=http://localhost:18080
